// Project: Kidney Care — Patient CKD Tracker
// Plan version: v0 / stage-1.1 (scope-reduced revision of stage-1)
// Generated: 2026-07-03
// Engine: Postgres (Supabase)
// DBML spec: https://dbml.dbdiagram.io/docs
//
// Scope of this stage: patient profile + vitals ONLY.
// All other stage-1 entities (care_team_members, lab_panels, lab_results,
// medications, medication_dose_logs, symptom_logs, diet_fluid_logs,
// appointment_series, appointments, dialysis_sessions, documents, reminders)
// are deferred to a later stage — see stage-1.dbml for their full design.

//////////////////////////////////////////////////////////
// Enums
//////////////////////////////////////////////////////////

Enum ckd_stage {
  stage_1
  stage_2
  stage_3a
  stage_3b
  stage_4
  stage_5
  dialysis
  transplant
}

Enum dialysis_type {
  none
  hemodialysis
  peritoneal
}

Enum reading_source {
  manual
  device
}

//////////////////////////////////////////////////////////
// Core
//////////////////////////////////////////////////////////

Table patients {
  id uuid [pk, default: `gen_random_uuid()`]
  auth_user_id uuid [unique, not null, note: 'FK to Supabase auth.users(id)']
  full_name text [not null]
  date_of_birth date
  sex text
  ckd_stage ckd_stage
  dialysis_type dialysis_type [default: 'none']
  height_cm numeric
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    auth_user_id [unique]
    updated_at [name: 'idx_patients_updated_at']
  }

  Note: 'Core account record, 1:1 with Supabase auth user for v1 (patient-only). Unchanged from stage-1.'
}

//////////////////////////////////////////////////////////
// Vitals — split into one table per metric (revision from stage-1's
// single generic vital_readings table)
//////////////////////////////////////////////////////////

Table blood_pressure_readings {
  id uuid [pk, default: `gen_random_uuid()`]
  patient_id uuid [not null]
  recorded_at timestamptz [not null]
  systolic integer [note: 'mmHg']
  diastolic integer [note: 'mmHg']
  heart_rate_bpm integer [note: 'bpm']
  source reading_source [not null, default: 'manual']
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (patient_id, recorded_at) [name: 'idx_bp_patient_time']
    (patient_id, updated_at) [name: 'idx_bp_patient_updated']
  }

  Note: 'systolic/diastolic and heart_rate_bpm are each independently nullable — app enforces at least one of (systolic & diastolic) or heart_rate_bpm is present per row, so BP-only, HR-only, or combined readings are all valid.'
}

Table blood_glucose_readings {
  id uuid [pk, default: `gen_random_uuid()`]
  patient_id uuid [not null]
  recorded_at timestamptz [not null]
  value_mg_dl numeric [not null, note: 'Canonical unit mg/dL — any mmol/L input converted at app layer before storing, DB always mg/dL']
  context text [note: 'Free text placeholder for now (e.g. fasting/post_meal/random/bedtime) — to become a formal ENUM in a later stage']
  source reading_source [not null, default: 'manual']
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (patient_id, recorded_at) [name: 'idx_glucose_patient_time']
    (patient_id, updated_at) [name: 'idx_glucose_patient_updated']
  }
}

Table weight_readings {
  id uuid [pk, default: `gen_random_uuid()`]
  patient_id uuid [not null]
  recorded_at timestamptz [not null]
  value_kg numeric [not null, note: 'Canonical unit kg — any lb input converted at app layer before storing, DB always kg']
  source reading_source [not null, default: 'manual']
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (patient_id, recorded_at) [name: 'idx_weight_patient_time']
    (patient_id, updated_at) [name: 'idx_weight_patient_updated']
  }
}

//////////////////////////////////////////////////////////
// Relationships
//////////////////////////////////////////////////////////

Ref: blood_pressure_readings.patient_id > patients.id
Ref: blood_glucose_readings.patient_id > patients.id
Ref: weight_readings.patient_id > patients.id
