// Project: Kidney Care — Patient CKD Tracker
// Plan version: v0 / s1 / s1.2 (small delta on s1.1)
// Generated: 2026-07-03
// Engine: Postgres (Supabase)
// DBML spec: https://dbml.dbdiagram.io/docs
//
// Scope of this delta: ONE change, discovered while planning the sync feature
// (see planning/sync/v0/stage-1.md) — patients.first_name / patients.last_name
// remain nullable so a DB trigger can bootstrap a bare patients row on auth.users
// insert, before the user has completed profile onboarding.
//
// Everything else is identical to s1.1 — see ../s1.1/s1.1.dbml for the
// unchanged blood_pressure_readings / blood_glucose_readings / weight_readings
// tables (not repeated here to avoid drift between copies; this file only
// restates `patients` since it's the one table that changed).


Table patients {
  id uuid [pk, default: `gen_random_uuid()`]
  auth_user_id uuid [unique, not null, note: 'FK to Supabase auth.users(id). Row is auto-created by a DB trigger on auth.users insert (see planning/sync/v0/stage-1.md 7.2)']
  first_name text
  last_name text
  date_of_birth date
  sex text
  ckd_stage ckd_stage
  dialysis_type dialysis_type [default: 'none']
  height_cm numeric
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    auth_user_id [unique]
    updated_at [name: 'idx_patients_updated_at']
  }

  Note: 'Core account record, 1:1 with Supabase auth user for v1 (patient-only). See s1.2.md for change rationale.'
}
