// Project: Kidney Care — Patient CKD Tracker
// Plan version: v0 / s2 (v1 feature port: measurement context, metadata, sharing)
// Generated: 2026-11-12
// Engine: Postgres (Supabase)
// DBML spec: https://dbml.dbdiagram.io/docs
//
// Stage-wide schema for s2. Only tables touched by s2 are listed; unchanged
// tables (patient_preferences, patient_medication_schedules) keep their s1-era
// shape and only get new RLS policies (see s2.md §5).

//////////////////////////////////////////////////////////
// Enums (documented as CHECK constraints in SQL)
//////////////////////////////////////////////////////////

Enum patient_access_role {
  owner     [note: 'full access + manage access']
  caregiver [note: 'read + write vitals/logs/profile']
  viewer    [note: 'read-only']
}

Enum bp_arm {
  left
  right
}

Enum bp_posture {
  sitting
  standing
  lying
}

Enum bp_dialysis_phase {
  pre_dialysis
  post_dialysis
}

Enum blood_group {
  "A+"
  "A-"
  "B+"
  "B-"
  "AB+"
  "AB-"
  "O+"
  "O-"
}

//////////////////////////////////////////////////////////
// Access
//////////////////////////////////////////////////////////

Table patients {
  id uuid [pk, default: `gen_random_uuid()`]
  auth_user_id uuid [unique, null, note: 'The account this record describes (self patient). NULL for patients created via create_patient. Immutable from clients. NOT used for authorization.']
  first_name text
  last_name text
  date_of_birth date
  sex text
  ckd_stage text
  dialysis_type text [default: 'none']
  dialysis_days_of_week jsonb
  height_cm numeric
  blood_group blood_group [null, note: 's2.2']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [note: 'Soft delete; owner-only (guard_patient_update trigger)']

  indexes {
    auth_user_id [unique]
    updated_at [name: 'idx_patients_updated_at']
  }

  Note: 'Patient record. Access via patient_access. Inserted only by signup bootstrap or create_patient RPC.'
}

Table patient_access {
  id uuid [pk, default: `gen_random_uuid()`]
  patient_id uuid [not null, ref: > patients.id, note: 'on delete cascade']
  user_id uuid [not null, note: 'FK auth.users(id) on delete cascade']
  role patient_access_role [not null]
  granted_by uuid [null, note: 'FK auth.users(id) on delete set null']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (patient_id, user_id) [unique, name: 'patient_access_patient_user_key']
    user_id [name: 'idx_patient_access_user']
  }

  Note: 'Written only by SECURITY DEFINER functions. Clients: SELECT own rows, or all rows of patients they own.'
}

Table profiles {
  user_id uuid [pk, note: 'FK auth.users(id) on delete cascade']
  username text [not null, unique, note: '^[a-z0-9_]{3,30}$']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Readable by owner only. Others resolve usernames via find_user_by_username / list_patient_members.'
}

//////////////////////////////////////////////////////////
// Logs (changed columns only + keys)
//////////////////////////////////////////////////////////

Table blood_pressure_readings {
  id uuid [pk]
  patient_id uuid [not null, ref: > patients.id]
  recorded_at timestamptz [not null]
  systolic integer
  diastolic integer
  heart_rate_bpm integer
  arm bp_arm [null, note: 's2.1']
  posture bp_posture [null, note: 's2.1']
  is_dialysis_day boolean [null, note: 's2.1; NULL = not recorded']
  dialysis_phase bp_dialysis_phase [null, note: 's2.1; requires is_dialysis_day = true']
  recorded_by uuid [null, note: 's2.2; auth.users(id), trigger-set']
  notes text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

Table blood_glucose_readings {
  id uuid [pk]
  patient_id uuid [not null, ref: > patients.id]
  recorded_at timestamptz [not null]
  value_mg_dl numeric [not null]
  context text [note: 'fasting | before_meal | post_meal | random | bedtime (app-validated)']
  recorded_by uuid [null, note: 's2.2']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

Table weight_readings {
  id uuid [pk]
  patient_id uuid [not null, ref: > patients.id]
  recorded_at timestamptz [not null]
  value_kg numeric [not null]
  recorded_by uuid [null, note: 's2.2']
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

Table fluid_intake_logs {
  id uuid [pk]
  patient_id uuid [not null, ref: > patients.id]
  recorded_at timestamptz [not null]
  fluid_ml numeric [not null]
  recorded_by uuid [null, note: 's2.2']
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

