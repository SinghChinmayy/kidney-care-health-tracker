// Project: Kidney Care — Patient CKD Tracker
// Plan version: v0 / s2 / s2.3 (patient_access + multi-patient RLS)
// Generated: 2026-11-12
// Engine: Postgres (Supabase)

Enum patient_access_role {
  owner
  caregiver
  viewer
}

Table patients {
  id uuid [pk]
  auth_user_id uuid [unique, null, note: 'was NOT NULL; self patient only; immutable from clients']
}

Table patient_access {
  id uuid [pk, default: `gen_random_uuid()`]
  patient_id uuid [not null, ref: > patients.id, note: 'on delete cascade']
  user_id uuid [not null, note: 'auth.users(id) on delete cascade']
  role patient_access_role [not null]
  granted_by uuid [null, note: 'auth.users(id) on delete set null']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (patient_id, user_id) [unique]
    user_id [name: 'idx_patient_access_user']
  }
}

