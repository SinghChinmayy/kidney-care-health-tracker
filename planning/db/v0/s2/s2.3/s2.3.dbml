// private.bootstrap_patient_on_signup(): self patient + owner access row
// private.guard_patient_update(): auth_user_id immutable; deleted_at owner-only
// public.create_patient(p_first_name, p_last_name, p_id, p_date_of_birth, p_sex, p_blood_group) -> patients
//
// RLS (all app tables):
//   patients:   select viewer+, update caregiver+, no insert/delete (privileges revoked)
//   children:   select viewer+, insert/update/delete caregiver+
//   patient_access: select own row or owner; NO write privileges
